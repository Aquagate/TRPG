{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rift.schema.json",
  "title": "Rift",
  "type": "object",
  "required": ["id", "aFactId", "bFactId", "status", "darknessCost", "notes", "updatedAt"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "aFactId": { "type": "string", "format": "uuid" },
    "bFactId": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["open", "sealed"] },
    "darknessCost": { "type": "number", "minimum": 0 },
    "notes": { "type": "array", "items": { "type": "string" } },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
